{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/calcul-heures-de-travail",
      "destination": "/calcul-heures-travail",
      "permanent": true
    },
    {
      "source": "/calcul-heure",
      "destination": "/calcul-heures-travail",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}